    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Component.AudioComponent zipper {"hint":"Zipper cue (bead peel), on Audio/Zipper"}'
    - '// @input Component.AudioComponent chime {"hint":"Chime cue (far-side marker), on Audio/Chime"}'
    - '// @input Component.AudioComponent tick {"hint":"Tick cue (any button), on Audio/Tick"}'
    - '// @input Component.AudioComponent click {"hint":"Click cue (lever snaps into its socket), on Audio/Click"}'
    - '// @input Component.AudioComponent nope {"hint":"Nope cue (lever released far from the socket), on Audio/Nope"}'
    - '// @input Component.AudioComponent done {"hint":"Done cue (repair finished), on Audio/Done"}'
    - '// @input Component.AudioComponent hiss {"hint":"Hiss cue (valve pressed on the deflate step), on Audio/Hiss"}'
    - '// @input Component.AudioComponent pump {"hint":"Pump loop (valve held on the inflate step), on Audio/Pump"}'
    - '// @input Component.AudioComponent finish {"hint":"Finish cue (flat fixed, step 11), on Audio/Finish"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float zipperVolume = 0.35 {"hint":"Zipper volume (kept low; it retriggers per bead segment)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float chimeVolume = 0.4 {"hint":"Chime volume", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float tickVolume = 0.25 {"hint":"Tick volume (quietest: it plays on every button)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float feedbackVolume = 0.4 {"hint":"Click and nope volume", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float doneVolume = 0.45 {"hint":"Done volume", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float hissVolume = 0.35 {"hint":"Hiss volume (quiet air release)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float pumpVolume = 0.4 {"hint":"Pump loop volume", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float finishVolume = 0.5 {"hint":"Finish cue volume", "widget":"slider", "min":0, "max":1, "step":0.05}'
