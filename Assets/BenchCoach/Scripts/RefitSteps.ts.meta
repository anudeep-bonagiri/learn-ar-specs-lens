    - "// @input AssignableType_5 rimDrag {\"hint\":\"Rim drag on lever B (re-posed at 5 o'clock when step 8 is undone)\"}"
    - '// @input SceneObject leverSocketB {"hint":"LeverSocketB (rim drag start)"}'
    - '// @input AssignableType_6 wheelTargets {"hint":"Pinch targets on the valve and beads"}'
    - '// @input AssignableType_7 highlighter {"hint":"Pulsing glow on the parts the step wants touched"}'
    - '// @input AssignableType_8 audio {"hint":"Cue player (click, nope, pump loop)"}'
    - '// @input AssignableType_9 feedback {"hint":"Mistake feedback: a new tube end released away from the valve hole"}'
    - '// @ui {"widget":"group_end"}'
