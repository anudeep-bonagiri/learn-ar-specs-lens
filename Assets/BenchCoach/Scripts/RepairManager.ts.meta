  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">RepairManager – step machine 0..11</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject wheel {"hint":"Wheel assembly root (hidden until Found it)"}'
    - '// @input SceneObject stand {"hint":"Repair stand root (hidden until Found it)"}'
    - '// @input SceneObject environment {"hint":"Workshop dressing root (floor mat, floor path); shown with the wheel"}'
    - '// @input SceneObject tire {"hint":"Tire group holding Bead_0..7 (scaled 4% down on deflate)"}'
    - '// @input SceneObject valve {"hint":"Valve stem (step 1 marker anchor)"}'
    - '// @input AssignableType_1 wheelTargets {"hint":"Pinch targets on the valve and beads"}'
    - '// @input SceneObject startCard {"hint":"StartCard root (step 0 only)"}'
    - '// @input SceneObject stepMarker {"hint":"The single StepMarker ring"}'
    - '// @input AssignableType_2 stepLabel {"hint":"Step label panel"}'
    - '// @input SceneObject toolTray {"hint":"ToolTray root (levers inside), shown from step 3"}'
    - '// @input AssignableType_3 ghost {"hint":"Ghost lever animator (step 3)"}'
    - '// @input SceneObject leverSocket {"hint":"LeverSocket: snap target on the bead at the valve"}'
    - '// @input AssignableType_4 leverA {"hint":"Lever A placement controller"}'
    - '// @input SceneObject leverSocketB {"hint":"LeverSocketB: snap target 5 cm along the rim from socket A"}'
    - '// @input AssignableType_5 leverB {"hint":"Lever B placement controller"}'
    - '// @input AssignableType_6 rimDrag {"hint":"Rim drag controller on lever B"}'
    - '// @input AssignableType_7 tubePull {"hint":"Tube pull controller on TubeEnd"}'
    - '// @input SceneObject tubeEnd {"hint":"TubeEnd (step 5 marker anchor)"}'
    - '// @input AssignableType_8 thorn {"hint":"ThornHotspot in the tire (step 6 search target)"}'
    - '// @input AssignableType_9 audio {"hint":"Cue player (zipper, click, nope, done)"}'
    - '// @input AssignableType_10 doneCard {"hint":"Done card (step 7)"}'
    - '// @input AssignableType_11 ticks {"hint":"Dim ticks left on the parts of completed steps"}'
    - '// @input AssignableType_12 highlighter {"hint":"Pulsing glow on the parts the current step wants touched"}'
    - '// @input SceneObject tube {"hint":"Tube group (TubeSeg_0..7 and TubeEnd): hidden until a bead lifts"}'
    - '// @input AssignableType_13 refit {"hint":"StepModule for steps 8..10 (fit the new tube, seat the bead, inflate)"}'
    - '// @input AssignableType_14 finishCard {"hint":"Finish card (step 11): time, stats, prevention tip"}'
    - '// @input AssignableType_15 stats {"hint":"Run counters shown on the Finish card"}'
    - '// @input AssignableType_16 feedback {"hint":"Mistake feedback (nope plus a reason on the label)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float beadRadiusCm = 33.4 {"hint":"Bead major radius in cm (matches the Bead_i TorusArc)", "widget":"slider", "min":10, "max":60, "step":0.1}'
    - '// @input float markerStandoffCm = 1.5 {"hint":"Marker stand-off in front of the part, in cm", "widget":"slider", "min":0, "max":10, "step":0.5}'
    - '// @input float labelOffsetCm = 10 {"hint":"How far the step callout stands off the wheel toward the user, in cm", "widget":"slider", "min":4, "max":30, "step":0.5}'
    - '// @input float deflateScale = 0.96 {"hint":"Tire scale after deflating (0.96 = 4% smaller)", "widget":"slider", "min":0.8, "max":1, "step":0.01}'
    - '// @input float beadPushCm = 0.5 {"hint":"How far each loosened bead shifts toward the rim center, in cm", "widget":"slider", "min":0.1, "max":3, "step":0.1}'
    - '// @input float beadLiftCm = 1 {"hint":"How far Bead_0 lifts radially outward when lever A hooks, in cm", "widget":"slider", "min":0.2, "max":5, "step":0.1}'
    - '// @input float thornRevealSec = 2.5 {"hint":"Seconds the found thorn and its label stay up before the Done card", "widget":"slider", "min":0, "max":6, "step":0.1}'
    - '// @input string causeId = "thorn" {"hint":"Default flat cause after reset / jumpToStep (Found it picks one at random)"}'
    - '// @input string forceCause {"hint":"Force this flat cause every run (thorn, glass, snakebite); empty = random on Found it"}'
    - '// @input float drillHoldSec = 0.8 {"hint":"Seconds a completed drill rep holds its result before the next rep", "widget":"slider", "min":0, "max":3, "step":0.1}'
    - '// @input bool debugLogs = true {"hint":"Print step transitions to the log"}'
    - '// @ui {"widget":"group_end"}'
