  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">FloorLevel – measured floor height, one source of truth</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input Component.DeviceTracking deviceTracking {\"hint\":\"Camera's DeviceTracking, used for the world-mesh path\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float fallbackFloorY = -150 {"hint":"Floor height (world y, cm) used until a measurement lands, and when no level is found"}'
    - '// @input vec3 probeCenter = "{-20, 0, -95}" {"hint":"Center of the ray rings on the floor plane (world x, z; y is ignored)"}'
    - '// @input float probeRadiusCm = 35 {"hint":"Radius of the inner ray ring, in cm (the outer ring is twice as wide)", "widget":"slider", "min":5, "max":100, "step":1}'
    - '// @input float probeRays = 8 {"hint":"Rays on the inner ring (plus one at the center; the outer ring has twice as many)", "widget":"slider", "min":3, "max":16, "step":1}'
    - '// @input float rayTopY {"hint":"Ray start and end heights (world y, cm)"}'
    - // @input float rayBottomY = -400
    - '// @input float maxWaitSec = 3 {"hint":"Earliest decision, in seconds: hits are pooled at least this long", "widget":"slider", "min":0.5, "max":10, "step":0.5}'
    - '// @input float meshWaitSec = 8 {"hint":"Extra seconds a World-Query-only level waits for world-mesh support (and before the fallback)", "widget":"slider", "min":0, "max":20, "step":0.5}'
    - '// @input float correctWindowSec = 20 {"hint":"Seconds after start during which a lower well-supported level still replaces the decision", "widget":"slider", "min":5, "max":60, "step":1}'
    - '// @input float minHits = 3 {"hint":"Distinct 10 cm floor cells a level needs", "widget":"slider", "min":1, "max":16, "step":1}'
    - "// @input float minSpreadCm = 60 {\"hint\":\"Horizontal spread (cm) a level's hits need; a floor is the lowest WIDE surface\", \"widget\":\"slider\", \"min\":10, \"max\":200, \"step\":5}"
    - "// @input float minDropCm = 120 {\"hint\":\"A floor must be at least this far below the eye (cm); higher levels are table tops or seats. 120, not 140: Colorful Home's floor is 135 cm below the eye, and table tops lose to a lower wide floor anyway\", \"widget\":\"slider\", \"min\":60, \"max\":200, \"step\":5}"
    - '// @input float outlierCm = 4 {"hint":"Half the height band (cm) that hits must share to count as one level", "widget":"slider", "min":0.5, "max":20, "step":0.5}'
    - '// @input float earlyHits = 16 {"hint":"A World-Query-only level decides before the mesh wait ends when this many hits agree on it...", "widget":"slider", "min":4, "max":80, "step":1}'
    - '// @input float earlyCells = 12 {"hint":"...over at least this many distinct 10 cm cells (and twice minSpreadCm of spread)...", "widget":"slider", "min":3, "max":60, "step":1}'
    - '// @input float earlyStableSec = 1 {"hint":"...and it has stayed the lowest wide level (within the band) for this many seconds", "widget":"slider", "min":0, "max":5, "step":0.25}'
    - '// @input float easeSec = 0.5 {"hint":"Seconds a change of floor level takes on screen (ease-out): stand, mat and path settle together", "widget":"slider", "min":0, "max":2, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
