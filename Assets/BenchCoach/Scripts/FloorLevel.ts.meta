  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">FloorLevel – measured floor height, one source of truth</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input Component.DeviceTracking deviceTracking {\"hint\":\"Camera's DeviceTracking, used for the world-mesh fallback\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float fallbackFloorY = -150 {"hint":"Floor height (world y, cm) used until a measurement lands, and when no ray hits"}'
    - '// @input vec3 probeCenter = "{-20, 0, -95}" {"hint":"Center of the ray ring on the floor plane (world x, z; y is ignored)"}'
    - '// @input float probeRadiusCm = 35 {"hint":"Radius of the ray ring, in cm", "widget":"slider", "min":5, "max":100, "step":1}'
    - '// @input float probeRays = 8 {"hint":"Rays on the ring (plus one at the center)", "widget":"slider", "min":3, "max":16, "step":1}'
    - '// @input float rayTopY {"hint":"Ray start and end heights (world y, cm)"}'
    - // @input float rayBottomY = -400
    - '// @input float maxWaitSec = 3 {"hint":"Seconds to keep collecting World Query hits before deciding", "widget":"slider", "min":0.5, "max":10, "step":0.5}'
    - '// @input float meshWaitSec = 8 {"hint":"Extra seconds to retry world-mesh raycasts (the mesh builds over time) before the fallback", "widget":"slider", "min":0, "max":20, "step":0.5}'
    - '// @input float minHits = 3 {"hint":"Inlier hits needed to accept a measurement", "widget":"slider", "min":1, "max":16, "step":1}'
    - '// @input float minDropCm = 140 {"hint":"A floor must be at least this far below the eye (cm); higher levels are table tops or seats (the Lens is used standing)", "widget":"slider", "min":60, "max":200, "step":5}'
    - '// @input float outlierCm = 4 {"hint":"Half the height band (cm) that hits must share to count as one level", "widget":"slider", "min":0.5, "max":20, "step":0.5}'
    - '// @ui {"widget":"group_end"}'
