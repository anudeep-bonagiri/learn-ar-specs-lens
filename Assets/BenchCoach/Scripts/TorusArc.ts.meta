    - '// @input float bandBelowCos = 0.38 {"hint":"Faces whose radial normal is below this go to the band (0.38 keeps about 135 degrees of tread)"}'
    - '// @input Asset.Material stripeMaterial {"hint":"Optional third material: a thin line round each sidewall; empty = none"}'
    - '// @input float stripeFromCos = 0.1 {"hint":"Sidewall line: faces whose radial normal is at least this go to the line"}'
    - '// @input float stripeToCos = 0.3 {"hint":"Sidewall line: faces whose radial normal is at most this go to the line"}'
