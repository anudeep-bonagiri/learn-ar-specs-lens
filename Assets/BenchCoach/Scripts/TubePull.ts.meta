  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">TubePull – pull the tube out of the tire</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject wheel {"hint":"Wheel root (its center is the pull-distance origin)"}'
    - '// @input SceneObject tube {"hint":"Tube group holding TubeSeg_0..7"}'
    - '// @input SceneObject valve {"hint":"Valve stem (lifts out last)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input vec3 colliderSizeCm = {7,7,7} {"hint":"Grab box on the tube end, in world cm"}'
    - '// @input float pullDistanceCm = 15 {"hint":"How far beyond the rim the tube end must be pulled, in cm", "widget":"slider", "min":5, "max":40, "step":0.5}'
    - '// @input float rimRadiusCm = 33.4 {"hint":"Tube major radius in cm (matches the TubeSeg_i TorusArc). Literal: @input defaults cannot reference imported constants.", "widget":"slider", "min":10, "max":60, "step":0.1}'
    - '// @input float segmentLagCm = 1.5 {"hint":"Pull distance past the rim between one segment starting and the next, in cm", "widget":"slider", "min":0, "max":5, "step":0.1}'
    - '// @input float segmentRunCm = 6 {"hint":"Pull distance over which one segment goes from in the tire to fully out, in cm", "widget":"slider", "min":1, "max":20, "step":0.5}'
    - '// @input float segmentDropCm = 22 {"hint":"How far each segment drops (wheel -Y) when the tube comes out, in cm", "widget":"slider", "min":5, "max":40, "step":0.5}'
    - '// @input float segmentOutCm = 10 {"hint":"How far each segment moves toward the user (wheel +Z), in cm", "widget":"slider", "min":0, "max":30, "step":0.5}'
    - '// @input float staggerSec = 0.1 {"hint":"Delay between consecutive segments, in seconds", "widget":"slider", "min":0, "max":0.5, "step":0.01}'
    - '// @input float tweenSec = 0.5 {"hint":"Per-segment tween length, in seconds", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @input float valveLiftCm = 6 {"hint":"Valve lift after the tube is out, in cm (wheel +Y)", "widget":"slider", "min":0, "max":20, "step":0.5}'
    - '// @input float valveTweenSec = 0.4 {"hint":"Valve lift tween length, in seconds", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - '// @input float refitStaggerSec = 0.12 {"hint":"Refit: delay between consecutive segments going back in, in seconds", "widget":"slider", "min":0, "max":0.5, "step":0.01}'
    - '// @input float refitTweenSec = 0.3 {"hint":"Refit: per-segment slide-in length, in seconds", "widget":"slider", "min":0.05, "max":1, "step":0.05}'
    - '// @input float refitFromCm = 4 {"hint":"Refit: how far in front of the tire (wheel +Z) each segment starts its slide in, in cm", "widget":"slider", "min":0, "max":15, "step":0.5}'
    - '// @input float refitProudCm = 1.5 {"hint":"refit: each segment stops this far in front of the tire (cm) until all are in; then they seat together", "widget":"slider", "min":0, "max":5, "step":0.1}'
    - '// @input float refitSeatSec = 0.3 {"hint":"refit: seconds the whole new tube takes to press into the tire (the seated moment)", "widget":"slider", "min":0.05, "max":1, "step":0.05}'
    - "// @input vec4 refitTint = \"{1.0, 0.78, 0.45, 1}\" {\"hint\":\"refit: the new tube's tone while it feeds in (lighter than the tire); it fades back as it seats\", \"widget\":\"color\"}"
    - '// @input bool debugLogs {"hint":"Print pull progress to the log"}'
    - '// @ui {"widget":"group_end"}'
