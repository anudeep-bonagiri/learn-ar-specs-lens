  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ScanReveal – scan line and labels when the wheel appears</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 manager {"hint":"The step machine (plays on step 0 to 1)"}'
    - '// @input SceneObject wheel {"hint":"Wheel root: the line and labels live in its XY plane, in front of it"}'
    - '// @input SceneObject valve {"hint":"Valve object (its label sits just outside it)"}'
    - '// @input Asset.RenderMesh boxMesh {"hint":"Unit box mesh for the scan line"}'
    - '// @input Asset.Material markerMaterial {"hint":"Marker material; the line uses a blended copy"}'
    - '// @input AssignableType_2 audio {"hint":"Cue player (a tick as each label snaps on); optional"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float wheelRadiusCm = 38 {"hint":"Outer radius of the tire in cm; the line is a little taller and sweeps a little wider", "widget":"slider", "min":20, "max":60, "step":0.5}'
    - '// @input float sweepSec = 1.2 {"hint":"Seconds for the line to cross the wheel", "widget":"slider", "min":0.4, "max":4, "step":0.1}'
    - '// @input float holdSec = 2.5 {"hint":"Seconds the labels hold after the sweep", "widget":"slider", "min":0, "max":10, "step":0.5}'
    - '// @input float fadeSec = 0.4 {"hint":"Seconds the labels take to fade out", "widget":"slider", "min":0.1, "max":2, "step":0.1}'
    - "// @input float labelSize = 80 {\"hint\":\"Label text size; about 0.036 cm per unit on a world object (the step label's 33 is 1.2 cm tall), so 80 is 3 cm letters\", \"widget\":\"slider\", \"min\":20, \"max\":160, \"step\":1}"
    - '// @input float labelOutCm = 4 {"hint":"How far outside the tire the Rim label sits, in cm", "widget":"slider", "min":2, "max":20, "step":0.5}'
    - "// @input float rimLabelAngleDeg = 330 {\"hint\":\"Where the Rim label sits, degrees clockwise from 12 o'clock (330 = 11 o'clock: inside the preview's and Specs' view from the start pose)\", \"widget\":\"slider\", \"min\":0, \"max\":359, \"step\":1}"
    - "// @input float valveLabelAlongCm = 12 {\"hint\":\"Valve label offset along the rim from the valve, in cm (to the user's right); the step label panel sits straight above the valve\", \"widget\":\"slider\", \"min\":4, \"max\":20, \"step\":0.5}"
    - '// @input vec4 color = "{0.6, 1, 1, 1}" {"hint":"Line and label colour (cyan, like the highlights)", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
