  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ScanReveal – the outline trace and part labels when the wheel appears</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 manager {"hint":"The step machine (plays on step 0 to 1)"}'
    - '// @input SceneObject wheel {"hint":"Wheel root: the outline lives in its XY plane"}'
    - "// @input SceneObject valve {\"hint\":\"Valve object (the heads meet at it; its label's leader ends on it)\"}"
    - '// @input Asset.RenderMesh boxMesh {"hint":"Unit box mesh for the outline segments"}'
    - '// @input Asset.Material markerMaterial {"hint":"Marker material; the outline uses blended copies"}'
    - '// @input AssignableType_2 audio {"hint":"Cue player (a tick as each label pops on, a chime as the heads meet); optional"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float wheelRadiusCm = 34.6 {"hint":"Outer radius of the tire in cm (bead radius 33.4 + tube 1.2, with the tread); the outline hugs it", "widget":"slider", "min":20, "max":60, "step":0.1}'
    - '// @input float outlineGapCm = 0.6 {"hint":"Gap between the tread and the outline, in cm", "widget":"slider", "min":0, "max":4, "step":0.1}'
    - '// @input float outlineCm = 0.45 {"hint":"Outline thickness in cm (0.45 is about 0.3 degrees at 90 cm: a fine line)", "widget":"slider", "min":0.1, "max":2, "step":0.05}'
    - "// @input float sweepSec = 1.4 {\"hint\":\"Seconds for the two heads to run from 6 o'clock to the valve\", \"widget\":\"slider\", \"min\":0.4, \"max\":4, \"step\":0.1}"
    - '// @input float holdSec = 2.5 {"hint":"Seconds the outline and labels hold after the heads meet", "widget":"slider", "min":0, "max":10, "step":0.5}'
    - '// @input float fadeSec = 0.4 {"hint":"Seconds the outline and labels take to go", "widget":"slider", "min":0.1, "max":2, "step":0.1}'
    - "// @input float viewDistanceCm = 90 {\"hint\":\"Viewing distance the labels' type and grid are sized for, in cm\", \"widget\":\"slider\", \"min\":40, \"max\":160, \"step\":1}"
    - '// @ui {"widget":"group_end"}'
