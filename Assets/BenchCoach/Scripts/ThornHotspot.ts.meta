  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ThornHotspot – inspect step glint and thorn</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.RenderMesh glintMesh {"hint":"Unit sphere mesh for the glint"}'
    - '// @input Asset.Material glintMaterial {"hint":"Bright unlit material for the glint (no black on the additive display)"}'
    - '// @input Asset.RenderMesh thornMesh {"hint":"Unit cylinder mesh for the thorn spike"}'
    - '// @input Asset.Material thornMaterial {"hint":"Material for the revealed thorn"}'
    - '// @input Asset.RenderMesh shardMesh {"hint":"Unit box mesh for the glass shard"}'
    - '// @input Asset.Material shardMaterial {"hint":"Unlit material for the glass shard; a runtime copy is tinted with shardTint"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float glintSizeCm = 1 {"hint":"Glint diameter in cm", "widget":"slider", "min":0.3, "max":4, "step":0.1}'
    - '// @input float hitSizeCm = 5 {"hint":"Pinch hit box edge in cm (larger than the glint so the mouse can find it)", "widget":"slider", "min":1, "max":10, "step":0.5}'
    - '// @input float twinkleHz = 0.7 {"hint":"Twinkles per second while armed", "widget":"slider", "min":0.2, "max":4, "step":0.1}'
    - '// @input vec2 thornSizeCm = {1.8,0.3} {"hint":"Thorn spike length and thickness in cm"}'
    - '// @input float radiusCm = 34.2 {"hint":"Radius of the hotspot from the wheel center, in cm (on the tire)", "widget":"slider", "min":25, "max":40, "step":0.1}'
    - '// @input float depthCm = 2 {"hint":"Depth of the hotspot in front of the tire center, in cm", "widget":"slider", "min":0, "max":5, "step":0.1}'
    - '// @input vec4 shardTint = "{0.85, 0.97, 1.0, 1.0}" {"hint":"Glass shard color (pale and bright: dark vanishes on the additive display)", "widget":"color"}'
    - '// @input vec4 biteTint = "{1.0, 0.8, 0.5, 1.0}" {"hint":"Snakebite dot color (bright warm; drawn with a tinted copy of shardMaterial)", "widget":"color"}'
    - '// @input float biteDotCm = 0.9 {"hint":"Diameter of each snakebite dot, in cm", "widget":"slider", "min":0.2, "max":2, "step":0.05}'
    - '// @input float biteGapCm = 1.8 {"hint":"Distance between the two snakebite dots, in cm", "widget":"slider", "min":0.5, "max":4, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
